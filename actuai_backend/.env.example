# .env.example — copy to ".env" at the workspace root and adjust.
#
#     cp .env.example .env
#
# In production these values come from a secrets manager (the report uses
# HashiCorp Vault), never a file on disk. NEVER commit the real .env.

# ---- Runtime ----
ENV=dev
LOG_LEVEL=INFO

# ---- Datalake : PostgreSQL (SYNC driver, psycopg2) ----
# Matches docker-compose (actuai-postgres). The variable name is the one the
# backend's database/connection.py reads.
DATABASE_URL_BACKEND=postgresql://actuai_user:actuai_password@localhost:5432/actuai_db

# ---- Vector DB : Qdrant (RAG / Investigative agent) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=technical_documentation

# ---- Mock SAP / BAPI (actuai_mock_data) ----
BAPI_BASE_URL=http://localhost:8080
BAPI_POLL_SECONDS=60
# Start the background ETL poller on boot? Leave false for a clean offline boot.
ETL_AUTO_START=false

# ---- Auth (JWT) ----
# Generate a strong secret, e.g.:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_IN_PROD
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_HOURS=8

# ---- LLMs ----
OLLAMA_BASE_URL=http://localhost:11434
SUPERVISOR_MODEL=llama3.1:8b
CLOUD_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
CLOUD_LLM_API_KEY=
TRANSACTIONAL_MODEL=mistralai/mistral-nemo-12b-instruct
INVESTIGATIVE_MODEL=meta/llama-3.1-70b-instruct
RESPONDER_MODEL=mistralai/mistral-nemo-12b-instruct

# Set true to run with deterministic stub models (no Ollama / no cloud key).
USE_MOCK_LLM=true

# ---- CORS (frontends allowed to call the API) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
