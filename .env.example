# ============================================================================
# ActuAI — Global environment template (uv workspace)
# Copy to .env at the repository root and fill in the secrets.
#   cp .env.example .env
# ============================================================================

# ---- Mock data generators --------------------------------------------------
MOCK_NETWORK_DRIVE_DIR=./actuai_mock_data/output/network_drives
MOCK_EXCEL_DIR=./actuai_mock_data/output/excel_shares
DATABASE_URL=sqlite:///./sap_mock.db

# Where the simulated supplier emails are POSTed (backend ingestion route)
WEBHOOK_TARGET_URL=http://localhost:8000/api/ingest/email

# Shared secret expected in the X-Webhook-Token header of machine-to-machine
# ingestion calls. Empty = check disabled (dev only). Use a random string.
WEBHOOK_SHARED_SECRET=

# Automatic supplier-email cadence (seconds)
EMAIL_SEND_ENABLED=true
EMAIL_SEND_MIN_SECONDS=90
EMAIL_SEND_MAX_SECONDS=240

# ---- Datalake ---------------------------------------------------------------
DATABASE_URL_BACKEND=postgresql+psycopg://actuai_user:actuai_password@localhost:5432/actuai_db
QDRANT_URL=http://localhost:6333

# ---- Auth JWT ---------------------------------------------------------------
# Generate a strong value: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# ---- LLMs (NVIDIA NIM, OpenAI-compatible) -----------------------------------
# false = real NVIDIA NIM calls ; true = deterministic stub (no network needed)
USE_MOCK_LLM=false
CLOUD_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# Any model available on the NIM catalog works. Pick one that is currently
# healthy — a model flagged "DEGRADED" by NVIDIA returns HTTP 400. The Llama 3.1
# family below is a safe, verified default; mistralai/mistral-nemotron is a good
# alternative for the transactional/responder roles when it is available.
SUPERVISOR_MODEL=meta/llama-3.1-8b-instruct
TRANSACTIONAL_MODEL=meta/llama-3.1-8b-instruct
INVESTIGATIVE_MODEL=meta/llama-3.1-70b-instruct
RESPONDER_MODEL=meta/llama-3.1-8b-instruct

# Google Gemini key used by the mock-data email generator
GOOGLE_API_KEY=

# ---- Mock SAP / ETL ----------------------------------------------------------
BAPI_BASE_URL=http://localhost:8080
BAPI_POLL_SECONDS=60
ETL_AUTO_START=false

# Proactive Mission-2 scan (schedule discrepancies vs supplier ETAs) each ETL tick
AOG_SCAN_ENABLED=true

# Index the technical PDFs into Qdrant when the backend starts
INDEX_DOCS_ON_START=false
